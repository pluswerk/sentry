{
  "name": "pluswerk/sentry",
  "description": "+Pluswerk TYPO3 extension: Sentry Client",
  "license": "GPL-2.0-or-later",
  "type": "typo3-cms-extension",
  "homepage": "https://www.pluswerk.ag/",
  "support": {
    "issues": "https://github.com/pluswerk/sentry/issues",
    "source": "https://github.com/pluswerk/sentry",
    "docs": "https://github.com/pluswerk/sentry/blob/master/README.md"
  },
  "require": {
    "php": "~8.1.0 || ~8.2.0 || ~8.3.0 || ~8.4.0",
    "ext-fileinfo": "*",
    "composer-runtime-api": "^2",
    "http-interop/http-factory-guzzle": "^1.2.0",
    "psr/log": "*",
    "sentry/sentry": "^4",
    "typo3/cms-core": "^11.5 || ^12.4 || ^13.4",
    "typo3/cms-frontend": "^11.5 || ^12.4 || ^13.4"
  },
  "require-dev": {
    "b13/make": "^0.1.8",
    "helhum/typo3-console": "^8.2",
    "phpunit/phpunit": "^10 || ^12.3",
    "pluswerk/grumphp-config": "^7.2.0 || ^10.1.1",
    "pluswerk/sentry_test_extension": "@dev",
    "saschaegerer/phpstan-typo3": "^1.10.2 || ^2.1.1",
    "ssch/typo3-rector": "^2.13.1 || ^3.6.2",
    "symfony/http-client": "^5.4 || ^6.4.19 || ^7.3.2",
    "typo3/cms-composer-installers": "^4.0-rc || ^5.0",
    "typo3/minimal": "^13",
    "typo3/cms-lowlevel": "*",
    "typo3/cms-tstemplate": "*"
  },
  "autoload": {
    "psr-4": {
      "Pluswerk\\Sentry\\": "Classes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pluswerk\\Sentry\\Tests\\": "Tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "ergebnis/composer-normalize": true,
      "php-http/discovery": true,
      "phpro/grumphp": true,
      "phpstan/extension-installer": true,
      "pluswerk/grumphp-config": true,
      "typo3/class-alias-loader": true,
      "typo3/cms-composer-installers": true
    },
    "sort-packages": true
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "sentry"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "config/test_extension",
      "options": {
        "symlink": true
      }
    }
  ],
  "scripts": {
    "post-autoload-dump": [
      "rm -rf var/sqlite",
      "mkdir -p public/typo3conf",
      "echo \"<?php return require __DIR__ . '/../../config/system/settings.php';\" > public/typo3conf/LocalConfiguration.php",
      "echo \"<?php require __DIR__ . '/../../config/system/additional.php';\" > public/typo3conf/AdditionalConfiguration.php",
      "typo3 database:updateschema -vvv '*'",
      "typo3 extension:setup -vvv",
      "typo3 cache:flush -vvv",
      "typo3 cache:warmup -vvv",
      "typo3 install:fixfolderstructure -vvv",
      "typo3 test-extension:setup-db -f -vvv"
    ],
    "test": [
      "phpunit --color=always"
    ],
    "run-test-server": [
      "Composer\\Config::disableProcessTimeout",
      "SENTRY_MOCK=1 TYPO3_CONTEXT=Production php -S 0.0.0.0:1180 -t public/"
    ]
  }
}
